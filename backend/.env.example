# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sisa_db?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# App
PORT=3001
NODE_ENV=development

# CORS - frontend origin
FRONTEND_URL="http://localhost:3000"

# File Upload & Storage
PUBLIC_BASE_URL="http://localhost:3001"
UPLOAD_DIR="./uploads/kategori-sampah"
MAX_UPLOAD_MB=2

